<?xml version="1.0" encoding="utf-8"?>
<!--
  周视图的课程行（M3 卡片，2026-10-25 重写）
  底色 = 该课程的 tonal container，文字 = 同色系的 onContainer，都由图外层的
  ScheduleStyle.courseTone() 在代码里 set，因此这里不写死颜色（原来写死 #FFFFFF）。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Lanhang.CourseCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <TextView
            android:id="@+id/tvTimeLabel"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:text="@string/ph_period"
            android:textAppearance="@style/TextAppearance.Lanhang.LabelLarge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/ph_course_name"
                android:textAppearance="@style/TextAppearance.Lanhang.TitleSmall" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:alpha="0.86"
                android:text="@string/ph_lesson_meta"
                android:textAppearance="@style/TextAppearance.Lanhang.LabelMedium" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
