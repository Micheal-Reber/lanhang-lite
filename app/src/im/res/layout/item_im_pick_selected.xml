<?xml version="1.0" encoding="utf-8"?>
<!--
  已选成员条里的一格：头像 + 姓名，点一下取消选择。
  宽度固定 48dp，姓名放不下就省略号（这条是「概览」，不是列表）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_sm"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_xxs"
    android:paddingBottom="@dimen/space_xxs">

    <com.lanhang.lite.ui.AvatarView
        android:id="@+id/ivAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:contentDescription="@string/moments_cd_avatar" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Lanhang.LabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
