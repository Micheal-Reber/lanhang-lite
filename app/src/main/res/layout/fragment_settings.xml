<?xml version="1.0" encoding="utf-8"?>
<!--
  设置目录页。
  版式对齐 Hoshi Reader 的设置页（github.com/HuangAntimony/Hoshi-Reader-Android）：
  同类条目装一张 24dp 大圆角卡片、每行「左侧图标 + 标题 + 右侧 ›」、
  行与行之间用内缩 16dp 的分隔线，分组之间留 24dp，不写分区小标题（靠卡片分组）。
  行高与内边距取 M3 ListItem 规范：单行 56dp / 双行 72dp、左右 16dp、图标 24dp、图标与文字间隔 16dp。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDirectory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingTop="@dimen/screen_padding_h"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingBottom="@dimen/content_padding_bottom">

            <!-- ========== 分组一：我的资料 / 外观 / 工具 / 网上办事大厅 ========== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 我的资料（双行：姓名 + 学号；设置最顶端，2026-10-26 用户要求） -->
                    <LinearLayout
                        android:id="@+id/rowAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <!-- 头像：照片取不到时自动退成姓名首字（AvatarView 内部处理） -->
                        <com.lanhang.lite.ui.AvatarView
                            android:id="@+id/ivAccountAvatar"
                            android:layout_width="@dimen/avatar_settings"
                            android:layout_height="@dimen/avatar_settings"
                            android:contentDescription="@string/settings_account" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAccountName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="--"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvAccountMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!--
                      退出登录（2026-10-27 从顶栏溢出菜单移入）：紧贴账号卡下方 ——
                      它作用的对象就是上面这个账号，放在别处会让人以为退出的是别的东西。
                      不带 chevron：这一行不是「进去看看」，点了直接弹确认框。
                    -->
                    <LinearLayout
                        android:id="@+id/rowLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_logout"
                            app:tint="?attr/colorError" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/action_logout"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorError" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 外观 -->
                    <LinearLayout
                        android:id="@+id/rowAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_palette"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/settings_appearance"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 工具：上课提醒、导出课表、身份码、图书馆座位、校园网、工作圈过滤、接口调试的统一入口 -->
                    <LinearLayout
                        android:id="@+id/rowTools"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <!-- 图标用 handyman（扳手+螺丝刀）：不能再用 ic_settings，
                             那是底部导航「设置」Tab 的图标，放在这一行会让人以为是同一个入口 -->
                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_handyman"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/settings_tools"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 网上办事大厅：单行，不带副标题（2026-10-26 用户要求） -->
                    <LinearLayout
                        android:id="@+id/rowOaHall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_view_grid"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/settings_oa_hall"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 成员录：组织架构浏览 + 找人（只有「看个人主页」一个出口，无任何通信功能） -->
                    <LinearLayout
                        android:id="@+id/rowDirectory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_group"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/settings_directory"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xl" />

            <!-- ========== 分组二：诊断 / 关于 ========== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 诊断与日志：2026-10-26 从「关于」二级页提到目录页（参考版式第二组就装了诊断） -->
                    <LinearLayout
                        android:id="@+id/rowDiagnostics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bug_report"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/settings_diagnostics"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 清除缓存：副标题直接显示当前占用，不用点进去才知道有多少 -->
                    <LinearLayout
                        android:id="@+id/rowClearCache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_clean"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_clear_cache"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvCacheSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 关于：单行，版本号在二级页里（参考版式不带副标题） -->
                    <LinearLayout
                        android:id="@+id/rowAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/settings_about_app"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/detailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
