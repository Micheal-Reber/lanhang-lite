<?xml version="1.0" encoding="utf-8"?>
<!--
  聊天页一条消息：气泡宽度受屏幕 78% 限制，靠左右由代码按「是不是我发的」设 gravity。

  图片与视频共用同一个 [mediaBox]：视频在封面之上叠一个播放角标和时长，
  图片时那两个叠层 GONE。这样列表只有一个媒体块，不会出现「图片位置空一格」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/card_padding"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:id="@+id/mediaBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!--
          图片/视频封面：和文字气泡二选一（代码里按 kind 切 GONE/VISIBLE）。
          adjustViewBounds 让高度跟着图走，maxWidth/maxHeight 由代码按屏幕宽度设（窄屏固定值会顶边）。
          圆角靠 clipToOutline + bg_im_image（GradientDrawable 有 outline，不用引第三方变换库）。
        -->
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_im_image"
            android:clipToOutline="true"
            android:contentDescription="@string/im_image"
            android:scaleType="fitCenter" />

        <!-- 视频播放角标：半透明黑圆 + 白色三角 -->
        <TextView
            android:id="@+id/tvPlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_im_play"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- 视频时长：右下角小胶囊 -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_im_duration"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textAppearance="@style/TextAppearance.Lanhang.LabelSmall"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:textAppearance="@style/TextAppearance.Lanhang.LabelSmall"
        android:textColor="?attr/colorError"
        android:visibility="gone" />
</LinearLayout>
