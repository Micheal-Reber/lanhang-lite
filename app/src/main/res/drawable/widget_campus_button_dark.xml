<?xml version="1.0" encoding="utf-8"?>
<!--
  校园网小组件「一键认证」按钮底 · 深色主题。

  配色走项目 M3 规范（values-night/colors.xml）：
  深色模式的 primary 必须换成**亮调**（tone 80）—— #8ED8F8，
  onPrimary 取深色 #00344D。这条规范在 AGENTS.md/colors.xml 里写得很明确：
  「深色模式必须换成亮调，否则压在深色容器上几乎看不见」。
  所以深色下按钮底是**亮蓝**，不是浅色模式那个深蓝 #084168。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="#FF8ED8F8" />
</shape>
