<?xml version="1.0" encoding="utf-8"?>
<!--
  设置 → 工具 → 工作圈过滤 → 不看的人。

  顶栏必须走 `Widget.Lanhang.Toolbar` + wrap_content + minHeight：
  insets 回调给它补 `paddingTop = 状态栏高度`，高度若写死 actionBarSize(56dp)，
  这份 padding 会在固定高度的内部占位，状态栏一扣只剩二十来像素 ——
  表现就是「顶栏整个看不见」，标题和返回键都被压没了。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/moments_blocked_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xl"
            android:scrollbars="none" />

        <!-- 空态：图标 + 一句结论 + 一句「怎么把人加回来」，不只说一句 empty -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2xl"
            android:paddingEnd="@dimen/space_2xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                android:src="@drawable/ic_person"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/moments_blocked_empty_title"
                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/moments_blocked_empty_hint"
                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
