<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 顶栏：左日历 | 居中 < 第N周 > | 右视图切换 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp">

                <ImageButton
                    android:id="@+id/btnCalendar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="跳转周次"
                    android:src="@drawable/ic_calendar"
                    android:padding="6dp"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrevWeek"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="上一周"
                        android:src="@drawable/ic_chevron_left"
                        android:padding="6dp"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvWeekPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_week_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="第 1 周"
                        android:textColor="@color/week_pill_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnNextWeek"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="下一周"
                        android:src="@drawable/ic_chevron_right"
                        android:padding="6dp"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnViewToggle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="切换网格/周视图"
                    android:src="@drawable/ic_view_grid"
                    android:padding="6dp"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <!-- 周视图内容 -->
            <FrameLayout
                android:id="@+id/contentWeek"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/weekScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/weekContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="96dp">

                        <!-- 7天摘要条 -->
                        <LinearLayout
                            android:id="@+id/dayStrip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal" />

                        <!-- 每天课程区 -->
                        <LinearLayout
                            android:id="@+id/daySections"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="本周无课"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 网格视图内容 -->
            <FrameLayout
                android:id="@+id/contentGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/bg_grid_panel"
                android:padding="8dp">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/gridScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="96dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/gridContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </androidx.core.widget.NestedScrollView>
            </FrameLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
