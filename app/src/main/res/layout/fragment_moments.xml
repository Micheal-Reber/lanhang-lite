<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          这里刻意不放任何过滤提示条（「已过滤 N 条」「恢复过滤」之类）。
          被挡内容的唯一入口在「设置 → 工作圈过滤 → 查看过滤消息」，
          时间线顶部保持干净，列表就是纯粹的动态流。
        -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/screen_padding_h" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingStart="@dimen/space_2xl"
        android:paddingEnd="@dimen/space_2xl"
        android:text="@string/moments_empty"
        android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/fabPublish"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="96dp" />

    <!--
      原生底栏模式下的发表按钮（2026-11-02）：底栏换成 Material 之后这颗玻璃球就该跟着换掉，
      两者是同一套视觉，混着用会很突兀。与上面的 ComposeView 互斥显示，
      尺寸一致（`@dimen/fab_size`），位置差一档：
      玻璃 FAB 底边 96dp（对应 74dp 的玻璃胶囊 + 22dp 间隙），
      原生 FAB 底边 88dp（对应 72dp 的底栏 + 16dp 间隙，取 content_padding_bottom_native 同一个值）。

      配色走「主色底 + onPrimary 图标」，这是 Material 里主操作按钮的常见用法：
      默认的 primaryContainer 在深色主题下是低饱和的深蓝灰，和 surfaceContainer 的底栏挨在一起
      几乎分不开（2026-11-02 截图确认过）。品牌蓝底 + 白/深图标才够醒目，
      而且和底栏的 primary 选中色呼应。
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNative"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="@dimen/content_padding_bottom_native"
        android:contentDescription="@string/moments_cd_publish"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary" />
</FrameLayout>
