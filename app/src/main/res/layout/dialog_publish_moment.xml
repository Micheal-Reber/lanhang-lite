<?xml version="1.0" encoding="utf-8"?>
<!--
  发表动态面板。
  - 输入区无边框、放大字号与行距，长文写起来不挤
  - 图片区横向排列缩略图，末尾固定一个虚线「添加」方块，选满 9 张自动隐藏
  - 底部取消为文字按钮、发表为填充按钮，主次分明
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 标题行：标题 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/moments_publish_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 输入区 -->
    <EditText
        android:id="@+id/etContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/moments_publish_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingExtra="5dp"
        android:maxLines="10"
        android:minLines="4"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="16sp" />

    <!-- 字数统计：贴右，接近上限时变色 -->
    <TextView
        android:id="@+id/tvCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <!-- 图片区：缩略图 + 添加方块（由代码填充） -->
    <HorizontalScrollView
        android:id="@+id/imageScroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="6dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/imageRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 底部操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/moments_publish" />
    </LinearLayout>
</LinearLayout>
