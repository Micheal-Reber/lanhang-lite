<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        应用内更新（update/UpdateInstaller）：下载完要拉起系统安装器。
        这是 **normal 权限**，安装即授予；但 Android 8+ 还需要用户在本机打开
        「允许安装未知应用」，代码里用 canRequestPackageInstalls() 判断并跳设置页。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        校园网认证（campusnet/SrunApi.localIpv4）要读「当前承载流量的网卡」的 IPv4，
        ConnectivityManager.getActiveNetwork()/getLinkProperties() 需要这一条。
        这是 **normal 权限**：安装即授予，不会弹运行时对话框，也不需要用户去设置里开。
        缺它的表现是 SecurityException → 点「立即认证」直接失败（2026-10-26 真机实测），
        而且异常发生在算签名之前，看起来像「认证接口坏了」，实际一个请求都没发出去。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        工作圈互动提醒（Android 13+ 运行时权限）。
        未授权时只是没有系统通知，消息中心照常可用——所以申请失败不能影响任何主流程，
        具体申请时机与拒绝后的引导见 moments/MomentMessagesActivity。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        电池优化白名单：国产 ROM 的省电策略会把闹钟攒很久才放行。
        只用于「去设置」里的一键申请；精确闹钟权限和厂商后台策略是两套独立条件。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Android 16「实时动态通知」（Live Updates）：让课前提醒被系统提升成状态栏芯片
        （小米叫超级岛、原生叫实时活动）。这是**普通权限**，安装即授予；
        系统不支持或用户关掉「实时活动」时，同一个 flag 只是被忽略，通知照常显示。
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
        课前流体云：前台服务让进度条每 15s 真实推进。
        specialUse 是唯一能描述「课程实时卡片」的官方类型（不是 media / location 那些）。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        课程提醒的精确闹钟：课前 N 分钟要在那一刻响，普通 set() 在 Doze 下会被推迟到亮屏。
        SCHEDULE_EXACT_ALARM 由用户在系统页授予（Android 12+）；
        USE_EXACT_ALARM 是闹钟类应用的常规声明，两者都声明后按系统实际授权降级。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
        上课自动勿扰：`setInterruptionFilter` 需要的敏感权限，**只能用户手动授予**
        （系统设置 → 勿扰权限），代码弹不出来。没授权时我们什么都不做，也不改用户设置。
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 魅族 Flyme 实时通知总开关（普通权限，未授予时整条路径直接关闭） -->
    <uses-permission
        android:name="flyme.permission.READ_NOTIFICATION_LIVE_STATE"
        android:maxSdkVersion="35" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LanhangLite"
        android:usesCleartextTraffic="true">

        <!--
            更新包要通过 content:// 交给系统安装器（Android 7 起禁止 file:// 暴露）。
            路径见 res/xml/file_paths.xml：只开放两个下载目录，别写成 root-path。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            更新包下载完成（应用内更新）：系统把 ACTION_DOWNLOAD_COMPLETE 显式发回发起下载的应用，
            所以 exported=false。没有它，用户点完下载就切走时「已下载」状态永远写不进去。
        -->
        <receiver
            android:name=".update.UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_schedule_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ScheduleWidgetSmallProvider"
            android:exported="true"
            android:label="@string/widget_schedule_small_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_small_info" />
        </receiver>

        <!--
          校园网小组件：桌面一键认证。
          exported=true 是 AppWidgetProvider 的硬要求（系统要跨进程投递广播）。
          BOOT_COMPLETED 用于开机后重绘（重启后系统会再发一次 UPDATE，但状态缓存要重新落）。
        -->
        <receiver
            android:name=".widget.CampusNetWidgetProvider"
            android:exported="true"
            android:label="@string/widget_campus_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/campus_net_widget_info" />
        </receiver>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.OaWebViewActivity"
            android:exported="false" />

        <!-- 成员录（入口在「设置 → 成员录」）：顶部有搜索框，adjustResize 让列表跟着键盘缩 -->
        <activity
            android:name=".directory.DirectoryActivity"
            android:exported="false"
            android:label="@string/directory_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".schedule.ScheduleBackgroundActivity"
            android:exported="false"
            android:label="@string/schedule_bg_title" />

        <activity
            android:name=".moments.MyMomentsActivity"
            android:exported="false"
            android:label="@string/my_moments_title" />

        <activity
            android:name=".moments.MomentMessagesActivity"
            android:exported="false"
            android:label="@string/moments_messages_title" />

        <activity
            android:name=".moments.MomentDetailActivity"
            android:exported="false"
            android:label="@string/moments_detail_title" />

        <!-- 关键词过滤设置页（入口在「设置 → 工作圈过滤」） -->
        <activity
            android:name=".moments.MomentsFilterActivity"
            android:exported="false"
            android:label="@string/moments_filter_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 被过滤消息的查看页（入口在过滤设置页内部）：工作圈顶部不再挂过滤提示条 -->
        <activity
            android:name=".moments.FilteredMomentsActivity"
            android:exported="false"
            android:label="@string/moments_filtered_view_title" />

        <!-- 「不看 TA 的动态」名单管理（入口：设置 → 工具 → 工作圈过滤 → 不看的人） -->
        <activity
            android:name=".moments.BlockedUsersActivity"
            android:exported="false"
            android:label="@string/moments_blocked_title" />

        <!-- 诊断与日志（入口：设置目录第二张卡的「诊断与日志」）：整页展示 + 顶栏保存/分享 -->
        <activity
            android:name=".settings.DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_page_title" />

        <!-- 关键词搜索（入口在工作圈顶栏放大镜）：需要弹输入法，adjustResize 让结果区跟着缩 -->
        <activity
            android:name=".moments.MomentSearchActivity"
            android:exported="false"
            android:label="@string/moments_search_title"
            android:windowSoftInputMode="adjustResize" />

        <!--
          工作圈互动的定时检查（AlarmManager 每 15 分钟一次）。
          exported=false：只由本 App 的 PendingIntent / 系统开机广播投递。
          BOOT_COMPLETED 是必需的——闹钟不会被持久化，重启后不重新排就再也收不到提醒。
        -->
        <receiver
            android:name=".moments.MomentMessageReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.lanhang.lite.moments.MESSAGE_TICK" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".moments.UserProfileActivity"
            android:exported="false"
            android:label="@string/user_profile_title" />

        <activity
            android:name=".idcard.IdCardActivity"
            android:exported="false"
            android:label="@string/id_card_title" />

        <activity
            android:name=".moments.ImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.LanhangLite.Fullscreen" />

        <activity
            android:name=".moments.PublishMomentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".library.LibrarySeatActivity"
            android:exported="false"
            android:label="@string/library_seat_title" />

        <activity
            android:name=".library.MySeatBookingsActivity"
            android:exported="false"
            android:label="@string/library_seat_my_bookings" />

        <activity
            android:name=".library.SeatSignCodeActivity"
            android:exported="false"
            android:label="@string/seat_sign_code_title" />

        <activity
            android:name=".oa.OaHallActivity"
            android:exported="false"
            android:label="@string/oa_hall_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".campusnet.CampusNetActivity"
            android:exported="false"
            android:label="@string/campus_net_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 课程提醒设置页（入口：设置目录一级行）：无底栏，与身份码/校园网等二级页一致 -->
        <activity
            android:name=".reminder.ReminderActivity"
            android:exported="false"
            android:label="@string/reminder_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 课前流体云：前台服务载体，存活期即投放期（进度条每 15s 推进） -->
        <service
            android:name=".reminder.FluidCloudService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!--
            课程提醒的五个闹钟接收器（与 Sleepy 一一对应）：
            今日摘要 / 明日预告 / 每日零点的窗口重同步 / 单节课课前提醒 / 上课自动勿扰边界。
            全部 exported=false：只由本 App 的 PendingIntent 投递。
        -->
        <receiver
            android:name=".reminder.DailyNotifyReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.TomorrowNotifyReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BeforeClassScheduleReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BeforeClassNotifyReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.ClassDndReceiver"
            android:exported="false" />

        <!--
            开机 / 应用更新后重排：AlarmManager 的闹钟不跨重启，不重建就再也不响。
            MY_PACKAGE_REPLACED 覆盖「升级安装把已排闹钟清掉」的情况。
        -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
