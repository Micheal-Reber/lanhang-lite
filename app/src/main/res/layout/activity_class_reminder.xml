<?xml version="1.0" encoding="utf-8"?>
<!-- 设置 → 工具 → 上课提醒：开关 / 提前量 / 权限自检 / 测试 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/class_reminder_title" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingBottom="@dimen/space_3xl">

            <!-- ========== 总开关 ========== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/class_reminder_enable"
                        android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/class_reminder_enable_desc"
                        android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 课表没加载时的提示：不能用「今天没课」冒充，用户会以为开关失效 -->
            <TextView
                android:id="@+id/tvDataHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/class_reminder_no_data"
                android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- ========== 提醒内容 ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/class_reminder_section_content"
                android:textAppearance="@style/TextAppearance.Lanhang.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowAdvance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_lg"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/class_reminder_advance"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/class_reminder_advance_desc"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAdvanceSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorPrimary" />

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:layout_marginStart="@dimen/space_xs"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 上课自动勿扰：上课切「仅闹钟」，下课恢复（需要勿扰权限，点开即跳系统页） -->
                    <LinearLayout
                        android:id="@+id/rowDnd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_lg"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/class_reminder_dnd"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvDndDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swDnd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:minHeight="@dimen/touch_target_min" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- 下一次提醒：比空白更让人放心，能直接看出「算对了没有」 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_lg"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_lg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/class_reminder_next"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvNext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvPromoteHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_sm"
                        android:text="@string/class_reminder_promote_hint"
                        android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 权限自检 ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/class_reminder_section_permissions"
                android:textAppearance="@style/TextAppearance.Lanhang.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowNotify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_lg"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/class_reminder_perm_notify"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvNotifySummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:id="@+id/rowExact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_lg"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/class_reminder_perm_exact"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvExactSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:id="@+id/rowBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_two_line"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_lg"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/class_reminder_perm_battery"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvBatterySummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
