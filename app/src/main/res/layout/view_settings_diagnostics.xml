<?xml version="1.0" encoding="utf-8"?>
<!--
  诊断与日志（设置二级页，2026-11-14 由独立 Activity 迁入）：

    分组卡片：标签左 / 值右（包名、版本、Android、设备、时间）
    分区小标题「应用错误记录」 + 等宽卡片
    分区小标题「运行日志」 + 说明 + 等宽卡片
    顶栏的「保存 / 分享」两个动作由宿主 Toolbar 提供（菜单挂载见 SettingsFragment.syncToolbar）

  等宽只用在两个正文块上：时间戳、异常类名、PID 在比例字体里根本对不齐列，
  看得出「同一秒刷了十几条同样的错」才叫日志。

  不自己套 NestedScrollView：二级页的滚动交给宿主的 scrollDetail（内层再套一层会把滑动吃掉）。
  进度圈盖在内容上：采集期间内容 `invisible`（仍占位），圈居中显示，不会跳高度。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingTop="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/content_padding_bottom_bare"
        android:visibility="invisible">

            <!-- ========== 卡片一：包与运行环境（一卡多行，行间内缩分隔线） ========== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="35"
                            android:text="@string/diagnostics_field_package"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvPackage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="65"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="35"
                            android:text="@string/diagnostics_field_version"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvVersion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="65"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="35"
                            android:text="@string/diagnostics_field_android"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvAndroid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="65"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="35"
                            android:text="@string/diagnostics_field_device"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvDevice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="65"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="35"
                            android:text="@string/diagnostics_field_time"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="65"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xl" />

            <!-- ========== 应用错误记录 ========== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/diagnostics_app_errors"
                android:textAppearance="@style/TextAppearance.Lanhang.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvErrors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/space_md"
                    android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true" />
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xl" />

            <!-- ========== 运行日志 ========== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/diagnostics_section_log"
                android:textAppearance="@style/TextAppearance.Lanhang.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xxs"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/diagnostics_scope"
                android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/space_md"
                    android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true" />
            </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
