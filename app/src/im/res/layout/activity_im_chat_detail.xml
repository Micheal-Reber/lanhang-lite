<?xml version="1.0" encoding="utf-8"?>
<!--
  聊天详情（2026-11-15，对齐官方 `PrivateChatDetailActivity` / `ChatDetailActivity`）。

  结构照官方那一页：头像 + 名字 → 聊天内容（文件 / 图片 / 搜索三个格子）→
  添加新成员 → 消息免打扰 → 会话置顶 → 清除聊天记录。

  刻意没做「举报」：官方那个按钮点下去只起一个 2 秒定时器然后弹「举报成功，我们会认真核实」，
  **不发任何网络请求**（见反编译 `ui/ReportActivity.java`），纯假提交。本应用不做假功能。

  开关用的是原生 `SwitchCompat` 而不是 `MaterialSwitch`：这一页是「设置行 + 右侧开关」的版式，
  与项目其它设置页一致，行高 56dp（list_item_height_single）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/im_chat_detail_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingBottom="@dimen/content_padding_bottom_bare">

            <!-- 头部：头像 + 名字。单聊点一下进个人主页，群聊不可点 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/headerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="@dimen/space_xl">

                    <com.lanhang.lite.ui.AvatarView
                        android:id="@+id/ivAvatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Lanhang.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 聊天内容：文件 / 图片 / 搜索 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:text="@string/im_chat_content"
                        android:textAppearance="@style/TextAppearance.Lanhang.LabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm">

                        <LinearLayout
                            android:id="@+id/cellFile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md">

                            <ImageView
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_im_file"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/im_chat_files"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/space_md"
                            android:layout_marginBottom="@dimen/space_md"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/cellImage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md">

                            <ImageView
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_photo"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/im_chat_images"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/space_md"
                            android:layout_marginBottom="@dimen/space_md"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/cellSearch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md">

                            <ImageView
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_search"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/im_chat_search"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 添加新成员 / 免打扰 / 置顶 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowAddMember"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingEnd="@dimen/card_padding">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/im_chat_add_member"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingEnd="@dimen/card_padding">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/im_chat_mute"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swMute"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingEnd="@dimen/card_padding">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/im_chat_pin"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swPin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 清除聊天记录：危险操作，单独一张卡 + 二次确认 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lanhang.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <TextView
                    android:id="@+id/btnClear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/list_item_height_single"
                    android:paddingTop="@dimen/space_md"
                    android:paddingBottom="@dimen/space_md"
                    android:text="@string/im_chat_clear"
                    android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                    android:textColor="?attr/colorError" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
