<?xml version="1.0" encoding="utf-8"?>
<!--
  会话内历史（2026-11-15）：文件 / 图片 / 搜索三种用途共用这一个页面。

  为什么合成一页：三者的骨架完全一样（顶栏 + 列表 + 空态 + 进度圈），差别只有
  「取哪些消息」和「列表怎么排」。分成三个 Activity 会把同一套加载/空态/返回逻辑抄三遍。

  搜索模式下多一条搜索框（复用建群页那个 TextInputLayout 样式）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_back" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchBox"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:hint="@string/im_chat_search_hint"
        android:visibility="gone"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingBottom="@dimen/space_lg" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
