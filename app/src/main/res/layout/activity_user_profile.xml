<?xml version="1.0" encoding="utf-8"?>
<!--
  个人资料页（方案 B 第一级，对应官方 UserDetailActivity）。
  贴文不在这里，点「个人动态」进 MyMomentsActivity（第二级）。
  字段可见性全部由 UserProfileActivity 按服务端隐私位控制，布局里只负责排版。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/user_profile_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_h"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/screen_padding_h"
                android:paddingBottom="@dimen/space_xl">

                <!-- 头部：大头像 + 姓名 + 院系·职务 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_xl">

                        <com.lanhang.lite.ui.AvatarView
                            android:id="@+id/ivAvatar"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:contentDescription="@string/moments_cd_avatar" />

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Lanhang.HeadlineSmall"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                  发私信（2026-10-31，im 版专属）：看自己、或 lite 版没有私信实现时整卡隐藏。
                  工作圈点头像进到这里 → 也能发起私信，所以工作圈不需要额外的私信图标。
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMessage"
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/rowMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mode_comment"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/im_open_chat"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                  好友关系（2026-11-12，2026-11-13 精简为三态）：加好友 / 同意申请 / 等待对方同意。
                  「已是好友 → 删除好友」已挪到页面最下面那个红描边大按钮（btnDeleteFriend，
                  与「退出登录」同版式），所以这一卡在好友态时整卡隐藏。
                  与「发私信」同属私信能力，所以看自己、或 lite 版（ImBridge 没注入）时整卡隐藏；
                  lite 版加了好友也无处说话，不给半截功能。
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFriend"
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/rowFriend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_person"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvFriendLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:id="@+id/ivFriendChevron"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 快捷入口：个人动态（第二级页）。自己看自己时整卡隐藏（设置→当前账号只要资料） -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPosts"
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:id="@+id/rowPosts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/list_item_height_single"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/space_md">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dynamic_feed"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/list_icon_gap"
                            android:layout_weight="1"
                            android:text="@string/user_profile_posts"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 资料：手机号 / 学号(工号) / 邮箱 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInfo"
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/rowPhone"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/dividerStaffNo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:background="?attr/colorOutlineVariant" />

                        <include
                            android:id="@+id/rowStaffNo"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/dividerEmail"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:background="?attr/colorOutlineVariant" />

                        <include
                            android:id="@+id/rowEmail"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 组织：学校 / 院系 / 职务 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOrg"
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/rowSchool"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/dividerDepart"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:background="?attr/colorOutlineVariant" />

                        <include
                            android:id="@+id/rowDepart"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/dividerMajor"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:background="?attr/colorOutlineVariant" />

                        <include
                            android:id="@+id/rowMajor"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/dividerClass"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:background="?attr/colorOutlineVariant" />

                        <include
                            android:id="@+id/rowClass"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <View
                            android:id="@+id/dividerPost"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:background="?attr/colorOutlineVariant" />

                        <include
                            android:id="@+id/rowPost"
                            layout="@layout/item_profile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 有字段被打码时解释原因，避免用户以为页面坏了 -->
                <TextView
                    android:id="@+id/tvMaskHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:text="@string/user_profile_masked_hint"
                    android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <!-- 「不看 TA 的动态」。放页面底部而不是菜单里：这是低频但需要被看见的开关，
                     藏进溢出菜单基本等于没有。自己的主页不显示（由代码控制）。 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlockUser"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/moments_block_user"
                    android:visibility="gone" />

                <!-- 删除好友（2026-11-13 用户要求：从上面那张好友卡的行里挪出来，放到页面最下面，
                     和「退出登录」同一个版式）：删好友是破坏性动作，用整行红描边大按钮比挤在
                     卡片行里更醒目；只有「已是好友」时出现，所以与下面的退出登录不会同屏。 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteFriend"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:text="@string/friend_delete"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:icon="@drawable/ic_person_remove"
                    app:iconTint="?attr/colorError"
                    app:strokeColor="?attr/colorError" />

                <!-- 退出登录（2026-11-01 从设置目录页搬到这里）：账号卡在设置页能点进这个页面，
                     退出作用的对象是同一份会话，放在「我的资料」最下面更贴合语义，
                     也让设置目录页只留「进去看看」的条目。只有自己看自己时出现。 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/action_logout"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="?attr/colorError"
                    app:strokeColor="?attr/colorError" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/errorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2xl"
            android:paddingEnd="@dimen/space_2xl"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/common_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
