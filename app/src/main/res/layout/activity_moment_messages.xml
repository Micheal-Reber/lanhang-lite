<?xml version="1.0" encoding="utf-8"?>
<!--
  互动消息中心：顶栏 + 类型筛选（全部/评论/赞）+ 通知权限提示条 + 列表。
  结构与「我的动态」一致（Toolbar + SwipeRefresh + RecyclerView + 空态 + 进度圈），
  只是多了筛选条和权限提示条。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/moments_messages_title" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_padding_h"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!--
      通知权限提示条：仅当系统通知不可用（Android 13+ 未授权 / 用户在系统设置里关了通知）时出现。
      点击去申请；已经拒绝到「不再询问」时直接跳系统设置页，见 MomentMessagesActivity。
    -->
    <LinearLayout
        android:id="@+id/notifyBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_h"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_padding_h"
        android:background="@drawable/bg_moment_interact"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifications"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/moments_messages_notify_off"
            android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/moments_messages_notify_enable"
            android:textAppearance="@style/TextAppearance.Lanhang.LabelLarge"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_lg" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/space_2xl"
            android:paddingEnd="@dimen/space_2xl"
            android:text="@string/moments_messages_empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_medium"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
