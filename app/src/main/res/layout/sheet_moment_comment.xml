<?xml version="1.0" encoding="utf-8"?>
<!--
  评论 / 回复的输入弹层（M3 BottomSheet）。

  版式照官方蓝航的评论弹层（2026-11-04 用户指定）：居中标题 + 描边输入框 + 两个等宽按钮。
  刻意做得紧凑——弹层只占键盘上方那一块，不铺满整屏。

  版式：
  - 标题：居中（发表评论 / 回复 某某）
  - 输入框：M3 OutlinedBox，蓝色描边（?attr/colorPrimary）、12dp 圆角；
    默认 1 行、最多 4 行，超出后框内滚动（弹层只随内容长高，不会自己铺满屏）
  - 底栏：取消（tonal，左）+ 发送（主操作，右），各占一半宽度；空白时「发送」禁用

  弹层圆角/背景/遮罩由 BottomSheetDialog 的 M3 主题提供，这里不画任何背景。
  间距/字号/圆角一律走 @dimen token，颜色一律走 ?attr/color*，与全 App 一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding_h"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/screen_padding_h"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Lanhang.TitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilComment"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        app:boxBackgroundColor="@android:color/transparent"
        app:boxCornerRadiusBottomEnd="@dimen/corner_md"
        app:boxCornerRadiusBottomStart="@dimen/corner_md"
        app:boxCornerRadiusTopEnd="@dimen/corner_md"
        app:boxCornerRadiusTopStart="@dimen/corner_md"
        app:boxStrokeColor="?attr/colorPrimary"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/moments_comment_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingExtra="@dimen/space_xxs"
            android:maxLines="4"
            android:minLines="1"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/common_cancel" />

        <Space
            android:layout_width="@dimen/space_md"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/common_send" />
    </LinearLayout>
</LinearLayout>
