<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 暴露给系统安装器的路径（应用内更新用）。
  只开放「更新包实际会落到的两个目录」：
  - external-files-path ➜ getExternalFilesDir(DIRECTORY_DOWNLOADS)
  - files-path          ➜ filesDir（外部目录不可用时的退路）
  ⛔ 不要写 root-path / external-path：那等于把整个存储交给任何拿到 uri 的应用。
-->
<paths>
    <external-files-path
        name="updates_external"
        path="Download/" />
    <files-path
        name="updates_internal"
        path="downloads/" />
    <!--
        私信里收到的文件（打开时交给系统应用）。只开这一个子目录，不碰 filesDir 其他东西。
        文件由 ImChatActivity.copyToRecvDir 复制进来，文件名已清洗并带消息 key 前缀。
    -->
    <files-path
        name="im_recv"
        path="im/recv/" />
</paths>
