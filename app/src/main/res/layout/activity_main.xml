<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipChildren="false">

    <!--
      绘制顺序 = 声明顺序，这里刻意把容器放在顶栏之前：
      课表页的自定义背景会向上溢出盖住顶栏区域（见 ScheduleFragment.applyBackgroundOverflow），
      顶栏必须画在它上面，否则透明的顶栏底下那层背景会把标题和菜单图标盖掉。
      底栏 ComposeView 保持在最后，压在所有内容之上。
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- M3 small top app bar：surface 底 + onSurface 前景，高度不含状态栏（inset 在 MainActivity 补） -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/tab_schedule" />

    <!--
      课表 Tab 的顶栏内容：左侧「课表」标题，右侧周次数字与视图切换。
      2026-10-31 由课表页内的独立工具条搬到这里（顺带把课表页那一整行的高度还给了网格）。
      翻周只通过课表横向滑动完成，右上角周次数字点击后打开选择器。
      原日历按钮已删：点周次胶囊即弹周次选择弹层（ScheduleFragment.showWeekPicker）。

      约定：
      - 只在该 Tab 显示（MainActivity.showToolbarMain 切）；显示时 toolbar 自带标题留空，
        否则两处都画「课表」会重叠。其余 Tab / 二级页仍用 toolbar 的 title。
      - 声明在 toolbar 之后 = 画在它上面（课表页背景会向上溢出到顶栏区域）。
      - paddingTop 由 MainActivity 的 insets 监听补成状态栏高度，与 toolbar 标题同一基线。
      - 控件仍由 ScheduleFragment 绑监听与配色（视图搬家，逻辑不动）。
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scheduleHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/toolbar">

        <!-- 标题独立左对齐；不再用 weight 把周次导航挤到右侧。 -->
        <TextView
            android:id="@+id/scheduleHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:text="@string/tab_schedule"
            android:textAppearance="@style/TextAppearance.Lanhang.ToolbarTitle"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/scheduleActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 与工作圈顶栏动作一致：周次入口和视图切换都收在右上角。 -->
        <LinearLayout
            android:id="@+id/scheduleActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 周次数字：点击打开周次选择器。 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvWeekPill"
                style="@style/Widget.Lanhang.WeekPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:text="@string/ph_week" />

            <!-- 网格/周视图切换 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewSwitch"
                style="@style/Widget.Lanhang.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/schedule_switch_to_week"
                app:icon="@drawable/ic_view_week" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      底栏默认 gone（2026-10-31）：语言/主题切换会 recreate 整个 Activity，新实例在
      setContentView 那一刻底栏就是「VISIBLE + alpha 1」，随后 showToolbarSub 才把它淡出 ——
      中间那一帧足够看到一次「底栏闪一下」。默认收起后，只有 showToolbarMain 显式放出来才显示；
      二级页恢复时 showToolbarMain 刚设的 alpha=0 会立刻被 setBottomNavVisible(false) 收成 GONE。
    -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
      原生底栏（2026-11-02）：设置 → 外观 → 底栏 里可以选，与上面的液态玻璃互斥显示，
      同一时刻只有一个 VISIBLE。两条约束完全一样（贴父容器底部），差别只在形态：
      玻璃是浮起 10dp 的圆角胶囊、高 64dp；这个贴底、全宽、高 72dp（比 M3 默认的 80dp 压矮一档），
      背景 colorSurfaceContainer + 选中态胶囊指示器都由 Widget.Material3 默认值给，
      **不要在这里覆盖 itemIconTint / itemTextColor**：默认色对（未选中 onSurfaceVariant、
      选中 onSecondaryContainer）且已经带了深色变体。

      默认 gone：新装和升级上来的人看到的第一帧仍是液态玻璃，和以前一致；
      由 MainActivity.applyBottomBarStyle() 按偏好决定显示哪一个。

      高度走 Widget.Lanhang.BottomNav（72dp，比 M3 默认的 80dp 压矮一档），
      底部安全区由 activity root 的 paddingBottom 负责 —— BottomNavigationView 自己还会再垫一次
      系统导航栏 inset，那段在 MainActivity.setupNativeBottomBar 里被移除了，否则会变成 64 + inset。
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavNative"
        style="@style/Widget.Lanhang.BottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
