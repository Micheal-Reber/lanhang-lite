<?xml version="1.0" encoding="utf-8"?>
<!--
  课程详情：由 MaterialAlertDialogBuilder 承载（标题/圆角/背景/按钮全部交给 M3）。
  这里只提供「色条 + 标签值行」作为自定义内容，水平内边距由本布局自己给
  （M3 的 customPanel 不带 padding，见 material-1.12.0 的 m3_alert_dialog.xml）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- 课程色：M3 对话框没有标题色块，用 4dp 全宽色条保留按课程配色的识别度 -->
    <View
        android:id="@+id/colorBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_xs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_label_name"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_large" />

        <TextView
            android:id="@+id/tvCName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body_large" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_label_room"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_large" />

        <TextView
            android:id="@+id/tvCRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body_large" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_label_teacher"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_large" />

        <TextView
            android:id="@+id/tvCTeacher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body_large" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_label_week"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_large" />

        <TextView
            android:id="@+id/tvCWeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body_large" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_label_period"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_large" />

        <TextView
            android:id="@+id/tvCPeriod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body_large" />
    </LinearLayout>
</LinearLayout>
