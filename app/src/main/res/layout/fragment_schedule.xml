<?xml version="1.0" encoding="utf-8"?>
<!--
  课表页（2026-10-25 M3 化重写，2026-10-31 顶栏控件上移）

  M3 化要点：
  - 顶栏控件（日历 / 周次 / 视图切换）2026-10-31 已搬到 Activity 顶栏，见 activity_main.xml
    的 scheduleHeader —— 本页不再有自己的工具条，多出来的高度全部给网格。
  - 网格面板由 FrameLayout + 自绘圆角背景改成 MaterialCardView（M3 filled 低层容器）。
  - 进度由 ProgressBar 改成 M3 CircularProgressIndicator。
  - 自定义背景三层（底色/图片/遮罩）保持不变：它是用户功能，配色令牌由 ScheduleStyle 提供，
    M3 语义色只在"无自定义背景"时生效。
  - 所有间距/字号/圆角走 @dimen token。

  两层结构（2026-10-30）：
  - `bgSolidLayer/bgImageLayer/bgVeil` 是**背景层**，直接挂在根上、靠负 topMargin 溢出到顶栏与状态栏后面；
  - `contentLayer` 是**内容层**，包住下拉刷新与进度，Tab 切换的淡入只打在它上面。
  根视图**绝不能再整体做 alpha 动画**：ViewGroup 带 alpha 会离屏合成并按自身边界裁剪，
  溢出到顶栏后面那段背景在整个淡入期间会消失，最后 alpha 归 1 时「啪」地跳出来（用户实测闪一下）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipChildren="false">

    <!-- 自定义背景三层：底色/图片 → 自适应遮罩 → 内容 -->
    <View
        android:id="@+id/bgSolidLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bgImageLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/bgVeil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- 内容层：唯一允许参与 Tab 淡入的层级，背景三层留在外面保持不透明 -->
    <FrameLayout
        android:id="@+id/contentLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--
              周次翻页容器（2026-10-27 由「网格/列表两个固定容器」改为动态页面）：
              每一周都是一个独立视图树，横向拖动时相邻周并排跟着手指走，松手吸附。
              页面内容由 ScheduleFragment.buildPage 生成，翻页物理见 ScheduleWeekPager。

              网格视图的布局约定保持不变（2026-10-25 按参考设计重构）：
              不套 MaterialCardView 外壳，表格线直接铺在页面/自定义背景上、左右贴边；
              表头固定在滚动区之外（日期行始终可见，只有节次表格滚动），表头透明、背景能透上来。
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/pagerHost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!--
                  兜底提示：只在「一条课表数据都没有」（首载失败）时出现。
                  周内无课、整周无课都由页面自己画，跟着页面一起翻走。
                -->
                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/space_2xl"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 首次加载：M3 圆形进度 -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorSize="@dimen/space_3xl" />
    </FrameLayout>

</FrameLayout>
