<?xml version="1.0" encoding="utf-8"?>
<!--
  图书馆座位选座页。
  结构：顶栏（返回 + 我的预约）→ 可滚内容（空间 / 时间 / 座位图）→ 底部确认栏。
  底部确认栏是滚动区之外的独立 View，所以内容区不需要给底栏留 padding。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Lanhang.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:menu="@menu/menu_library_seat"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/library_seat_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_h"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/screen_padding_h">

                <!-- ============ 空间选择 ============ -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/roomChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true" />
                </HorizontalScrollView>

                <!-- ============ 时段 ============ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/rowStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/list_item_height_single"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/card_padding"
                            android:paddingEnd="@dimen/card_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/library_seat_start"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvStartValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorPrimary" />

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_marginStart="@dimen/space_xs"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:id="@+id/rowDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/list_item_height_single"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/card_padding"
                            android:paddingEnd="@dimen/card_padding">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/library_seat_duration"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvDurationValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                                android:textColor="?attr/colorPrimary" />

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_marginStart="@dimen/space_xs"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- ============ 座位图 ============ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Lanhang.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvMapTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.Lanhang.TitleSmall"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvFreeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 图例：颜色语义只看这里，别在别处另立一套 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:background="@drawable/bg_legend_free" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:layout_marginEnd="@dimen/space_md"
                                android:text="@string/library_seat_legend_free"
                                android:textAppearance="@style/TextAppearance.Lanhang.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <View
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:background="@drawable/bg_legend_taken" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:layout_marginEnd="@dimen/space_md"
                                android:text="@string/library_seat_legend_taken"
                                android:textAppearance="@style/TextAppearance.Lanhang.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <View
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:background="@drawable/bg_legend_selected" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:text="@string/library_seat_legend_selected"
                                android:textAppearance="@style/TextAppearance.Lanhang.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 座位图自己处理缩放与平移，**不能再套 HorizontalScrollView**：
                             缩放后需要双向平移，横滚容器会和内部拖动抢手势（见 SeatMapView 类注释）。
                             宽度用 match_parent，超宽内容在 View 内部拖动查看。 -->
                        <com.lanhang.lite.library.SeatMapView
                            android:id="@+id/seatMap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md" />

                        <TextView
                            android:id="@+id/tvMapHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.Lanhang.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- ============ 底部确认栏 ============ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/library_seat_select_seat"
                android:textAppearance="@style/TextAppearance.Lanhang.BodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvSelectionTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Lanhang.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:enabled="false"
            android:text="@string/library_seat_book" />
    </LinearLayout>
</LinearLayout>
